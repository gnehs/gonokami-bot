{
  "name": "gonokami-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build:cloud": "rm -rf tgcloud/lib tgcloud/handlers tgcloud/endpoints && tsc -p tsconfig.cloud.json",
    "build:web": "vite build",
    "build": "pnpm build:cloud && pnpm build:web",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.cloud.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "deploy": "pnpm build && tgcloud push && pnpm deploy:worker",
    "deploy:worker": "node scripts/bundle-sources.ts && wrangler deploy -c worker/wrangler.jsonc",
    "import-history": "node scripts/import-history.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  }
}
